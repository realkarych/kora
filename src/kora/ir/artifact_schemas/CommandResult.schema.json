{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kora:artifact:CommandResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_code",
    "signal",
    "termination",
    "stop_reason",
    "duration_ms",
    "repo",
    "commit",
    "base_commit",
    "protected_paths",
    "protection",
    "resources",
    "resource_set_digest",
    "resource_protection",
    "stdout",
    "stderr"
  ],
  "properties": {
    "exit_code": {
      "type": "integer",
      "minimum": -255,
      "maximum": 255
    },
    "signal": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      ]
    },
    "termination": {
      "type": "string",
      "enum": [
        "none",
        "interrupted",
        "killed",
        "killed_after_grace"
      ]
    },
    "stop_reason": {
      "type": "string",
      "enum": [
        "completed",
        "deadline",
        "cancel",
        "journal_unavailable"
      ]
    },
    "duration_ms": {
      "$ref": "#/$defs/Count"
    },
    "repo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
    },
    "commit": {
      "$ref": "#/$defs/Revision"
    },
    "base_commit": {
      "$ref": "#/$defs/Revision"
    },
    "protected_paths": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "protection": {
      "type": "string",
      "enum": [
        "verified",
        "unprotected"
      ]
    },
    "resources": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/Resource"
      }
    },
    "resource_set_digest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/Digest"
        }
      ]
    },
    "resource_protection": {
      "type": "string",
      "enum": [
        "protected",
        "none"
      ]
    },
    "stdout": {
      "$ref": "#/$defs/Stream"
    },
    "stderr": {
      "$ref": "#/$defs/Stream"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "protected_paths": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "protection": {
            "const": "unprotected"
          }
        }
      },
      "else": {
        "properties": {
          "protection": {
            "const": "verified"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resources": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "resource_set_digest": {
            "type": "null"
          },
          "resource_protection": {
            "const": "none"
          }
        }
      },
      "else": {
        "properties": {
          "resource_set_digest": {
            "$ref": "#/$defs/Digest"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "minimum": 0
          }
        }
      },
      "then": {
        "properties": {
          "signal": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "signal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stop_reason": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "termination": {
            "const": "none"
          }
        }
      }
    }
  ],
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "Count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "Revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[\\u0021-\\u007e]+(?![\\s\\S])"
    },
    "Resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "size",
        "executable"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!\\.{1,2}(?:/|$))(?![\\s\\S]*?/\\.{1,2}(?:/|$))[^/\\u0000-\\u001f\\u007f\\\\]+(?:/[^/\\u0000-\\u001f\\u007f\\\\]+)*(?![\\s\\S])"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262144
        },
        "executable": {
          "type": "boolean"
        }
      }
    },
    "Stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_ref",
        "payload_digest",
        "size",
        "observed_bytes",
        "eof",
        "truncated",
        "tail_base64"
      ],
      "properties": {
        "storage_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "payload_digest": {
          "$ref": "#/$defs/Digest"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "observed_bytes": {
          "$ref": "#/$defs/Count"
        },
        "eof": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "tail_base64": {
          "type": "string",
          "maxLength": 5464,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
        }
      }
    }
  }
}
